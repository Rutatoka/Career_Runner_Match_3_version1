    \u043E\u0442 60 000 \u0420\u0443\u0431 \u0443 \u043D\u043E\u0432\u0438\u0447\u043A\u0430
    \u0434\u043E 200 000 \u0420\u0443\u0431 \u0443 \u0430\u0440\u0442-\u0434\u0438\u0440\u0435\u043A\u0442\u043E\u0440\u0430.\n\u041D\u0443\u0436\u043D\u043E
    \u0437\u043D\u0430\u0442\u044C: Figma, Adobe, \u0442\u0438\u043F\u043E\u0433\u0440\u0430\u0444\u0438\u043A\u0443,
    \u043E\u0441\u043D\u043E\u0432\u044B UX \u0438 \u0446\u0432\u0435\u0442\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044F.\n\u0420\u0430\u0431\u043E\u0442\u0430:
