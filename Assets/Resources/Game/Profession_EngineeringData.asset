  courseDescription: "\u0418\u043D\u0436\u0435\u043D\u0435\u0440 \u043F\u0440\u043E\u0435\u043A\u0442\u0438\u0440\u0443\u0435\u0442
    \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u044B
    \u0438 \u0440\u0435\u0448\u0430\u0435\u0442 \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0435
    \u0437\u0430\u0434\u0430\u0447\u0438.\n\u0417\u0430\u0440\u043F\u043B\u0430\u0442\u0430:
    \u043E\u0442 70 000 \u0420\u0443\u0431 \u0434\u043E 220 000 \u0420\u0443\u0431
    \u0443 \u0432\u0435\u0434\u0443\u0449\u0435\u0433\u043E \u0438\u043D\u0436\u0435\u043D\u0435\u0440\u0430.\n\u041D\u0443\u0436\u043D\u043E
    \u0437\u043D\u0430\u0442\u044C: \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0443,
    \u0444\u0438\u0437\u0438\u043A\u0443, AutoCAD \u0438\u043B\u0438 SolidWorks,
    \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u044B \u043E\u0442\u0440\u0430\u0441\u043B\u0438.\n\u0420\u0430\u0431\u043E\u0442\u0430:
    \u0440\u0430\u0441\u0447\u0451\u0442\u044B, \u0447\u0435\u0440\u0442\u0435\u0436\u0438,
    \u0443\u0447\u0430\u0441\u0442\u0438\u0435 \u0432 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0435
    \u0438 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0430.\n\u0418\u043D\u0436\u0435\u043D\u0435\u0440\u044B
    \u0441\u0442\u0440\u043E\u044F\u0442 \u043C\u043E\u0441\u0442\u044B, \u0437\u0430\u0432\u043E\u0434\u044B,
