  courseDescription: "\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440 \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442
    \u043A\u043E\u043C\u0430\u043D\u0434\u0430\u043C\u0438, \u043F\u0440\u043E\u0435\u043A\u0442\u0430\u043C\u0438
    \u0438 \u0431\u0438\u0437\u043D\u0435\u0441-\u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0430\u043C\u0438.\n\u0417\u0430\u0440\u043F\u043B\u0430\u0442\u0430:
    \u043E\u0442 65 000 \u0420\u0443\u0431 \u0434\u043E 300 000 \u0420\u0443\u0431
    \u0443 \u0442\u043E\u043F-\u043C\u0435\u043D\u0435\u0434\u0436\u0435\u0440\u0430
    \u043A\u0440\u0443\u043F\u043D\u043E\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438.\n\u041D\u0443\u0436\u043D\u043E
    \u0437\u043D\u0430\u0442\u044C: \u043B\u0438\u0434\u0435\u0440\u0441\u0442\u0432\u043E,
    Agile, \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B, \u0444\u0438\u043D\u0430\u043D\u0441\u043E\u0432\u043E\u0435
    \u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435.\n\u0420\u0430\u0431\u043E\u0442\u0430:
    \u043F\u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430 \u0437\u0430\u0434\u0430\u0447,
    \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C \u0434\u0435\u0434\u043B\u0430\u0439\u043D\u043E\u0432,
    \u0440\u0430\u0431\u043E\u0442\u0430 \u0441 \u043B\u044E\u0434\u044C\u043C\u0438.\n\u0425\u043E\u0440\u043E\u0448\u0438\u0439
    \u043C\u0435\u043D\u0435\u0434\u0436\u0435\u0440 \u2014 \u044D\u0442\u043E \u0442\u043E\u0442,
    \u0431\u0435\u0437 \u043A\u043E\u0433\u043E \u043D\u0438 \u043E\u0434\u0438\u043D
    \u043F\u0440\u043E\u0435\u043A\u0442 \u043D\u0435 \u0432\u0437\u043B\u0435\u0442\u0438\u0442."
