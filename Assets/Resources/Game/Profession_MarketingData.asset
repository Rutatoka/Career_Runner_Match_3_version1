  courseDescription: "\u041C\u0430\u0440\u043A\u0435\u0442\u043E\u043B\u043E\u0433
    \u043F\u0440\u043E\u0434\u0432\u0438\u0433\u0430\u0435\u0442 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u044B
    \u0438 \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442 \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0435\u0439
    \u0431\u0440\u0435\u043D\u0434\u0430.\n\u0417\u0430\u0440\u043F\u043B\u0430\u0442\u0430:
    \u043E\u0442 55 000 \u0420\u0443\u0431 \u0434\u043E 180 000 \u0420\u0443\u0431 
    \u0443 \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044F
    \u043E\u0442\u0434\u0435\u043B\u0430.\n\u041D\u0443\u0436\u043D\u043E \u0437\u043D\u0430\u0442\u044C:
    \u0430\u043D\u0430\u043B\u0438\u0442\u0438\u043A\u0443, SMM, \u043A\u043E\u043D\u0442\u0435\u043A\u0441\u0442\u043D\u0443\u044E
    \u0440\u0435\u043A\u043B\u0430\u043C\u0443, \u043F\u0441\u0438\u0445\u043E\u043B\u043E\u0433\u0438\u044E
    \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u044F.\n\u0420\u0430\u0431\u043E\u0442\u0430:
    \u0437\u0430\u043F\u0443\u0441\u043A \u043A\u0430\u043C\u043F\u0430\u043D\u0438\u0439,
    \u0430\u043D\u0430\u043B\u0438\u0437 \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u0438,
    \u0440\u0430\u0431\u043E\u0442\u0430 \u0441 \u0441\u043E\u0446\u0441\u0435\u0442\u044F\u043C\u0438.\n\u0425\u043E\u0440\u043E\u0448\u0438\u0439
    \u043C\u0430\u0440\u043A\u0435\u0442\u043E\u043B\u043E\u0433 = \u043F\u0440\u043E\u0434\u0430\u0436\u0438
    \u0440\u0430\u0441\u0442\u0443\u0442, \u0431\u0440\u0435\u043D\u0434 \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043D
    \u0432\u0441\u0435\u043C."
